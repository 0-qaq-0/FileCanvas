{
  "name": "filecanvas",
  "version": "0.3.0",
  "private": true,
  "description": "先在画布中整理，再预览真实路径的 Windows 文件整理工具",
  "main": "06_构建产物/electron/main.cjs",
  "author": "FileCanvas",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node 04_构建脚本/dev.mjs",
    "build": "tsc --noEmit && vite build && node 04_构建脚本/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && node 02_测试/交互测试/electron.e2e.mjs",
    "format": "prettier --write 01_源码 02_测试 04_构建脚本 vite.config.ts vitest.config.ts tsconfig.json package.json README.md 05_项目文档",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --x64 --dir",
    "test:demo": "npm run build && node 02_测试/交互测试/demo.e2e.mjs",
    "test:ai": "npm run build && node 02_测试/交互测试/canvas-ai.e2e.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "cn.filecanvas.desktop",
    "productName": "FileCanvas",
    "directories": {
      "output": "07_发布成品"
    },
    "files": [
      "06_构建产物/**/*",
      "01_源码/assets/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "01_源码/assets/icon.ico",
      "artifactName": "FileCanvas-${version}-Windows-${arch}.${ext}"
    }
  }
}
