{
  "name": "filecanvas",
  "version": "0.6.0",
  "private": true,
  "description": "先在画布中整理，再预览真实路径的 Windows 文件整理工具",
  "main": "dist/electron/main.cjs",
  "author": "FileCanvas",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app tests scripts eslint.config.mjs",
    "format:check": "prettier --check app tests scripts vite.config.ts vitest.config.ts tsconfig.json package.json eslint.config.mjs",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/run-desktop-tests.mjs",
    "test:e2e": "npm run build && node tests/e2e/electron.e2e.mjs",
    "format": "prettier --write app tests scripts vite.config.ts vitest.config.ts tsconfig.json package.json README.md docs",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --x64 --dir",
    "test:demo": "npm run build && node tests/e2e/demo.e2e.mjs",
    "test:ai": "npm run build && node tests/e2e/canvas-ai.e2e.mjs",
    "test:expanded": "npm run build && node tests/e2e/expanded-flow.e2e.mjs",
    "test:smart": "npm run build && node tests/e2e/smart-organize.e2e.mjs",
    "test:tutorial": "npm run build && node tests/e2e/tutorial.e2e.mjs",
    "test:settings": "npm run build && node tests/e2e/settings.e2e.mjs",
    "test:views": "npm run build && node tests/e2e/views.e2e.mjs",
    "test:simple": "npm run build && node tests/e2e/simple-ui.e2e.mjs",
    "test:maturity": "npm run build && node tests/e2e/maturity.e2e.mjs",
    "test:sets": "npm run build && node tests/e2e/file-sets.e2e.mjs",
    "preview:simple": "npm run build && node scripts/preview-simple-ui.mjs",
    "source:zip": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "3.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "cn.filecanvas.desktop",
    "productName": "FileCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/assets/icon.ico",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "app/assets/icon.ico",
      "artifactName": "FileCanvas-${version}-Windows-${arch}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "onlyLoadAppFromAsar": true,
      "enableNodeOptionsEnvironmentVariable": false
    }
  }
}
