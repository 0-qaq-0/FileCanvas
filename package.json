{
  "name": "filecanvas",
  "version": "0.1.0",
  "private": true,
  "description": "先在画布中整理，再预览真实路径的 Windows 文件整理工具",
  "main": "dist-electron/main.cjs",
  "author": "FileCanvas",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/electron.e2e.mjs",
    "format": "prettier --write src electron tests scripts vite.config.ts tsconfig.json package.json README.md docs",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "cn.filecanvas.desktop",
    "productName": "FileCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "artifactName": "FileCanvas-${version}-Windows-${arch}.${ext}"
    }
  }
}
